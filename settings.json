{
  "model": "claude-sonnet-4-6",

  "permissions": {
    "allow": [
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo run*)",
      "Bash(cargo tree*)",
      "Bash(cargo doc*)",
      "Bash(cargo nextest*)",
      "Bash(cargo watch*)",
      "Bash(cargo expand*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git add src/*)",
      "Bash(git add tests/*)",
      "Bash(git add *.toml)",
      "Bash(git add *.md)",
      "Bash(git commit*)",
      "Bash(rg*)",
      "Bash(fd*)",
      "Bash(find src*)",
      "Bash(find tests*)",
      "Bash(cat src/*)",
      "Bash(cat tests/*)",
      "Bash(wc -l *)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(rustfmt*)",
      "Bash(rustup*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(git push --force*)",
      "Bash(chmod 777*)",
      "WebFetch(*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[hook] Running: $CLAUDE_TOOL_INPUT\" >> ~/.local/share/play/claude-audit.log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(cargo test*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[hook] Tests completed at $(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> ~/.local/share/play/claude-audit.log"
          }
        ]
      }
    ]
  },

  "env": {
    "CARGO_TERM_COLOR": "always",
    "RUST_BACKTRACE": "1",
    "RUST_LOG": "play=debug,warn"
  },

  "includeCoAuthoredBy": true,

  "cleanupPeriodDays": 30
}
