name: Hardware detection

on:
  workflow_dispatch:

jobs:
  detect-only:
    runs-on: [self-hosted, linux, gpu]
    steps:
      - uses: actions/checkout@v4
      - name: Install Rust
        run: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
      - name: Run detect-only
        run: ~/.cargo/bin/cargo run --bin helix -- --detect-only
```